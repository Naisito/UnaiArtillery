    "test:watch": "vitest",
    "firing-table": "tsx tools/firing_table.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "cesium": "^1.120.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^2.1.0"
  }
}
